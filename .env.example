# 知妍 AI 环境配置示例：复制为 .env 后填入真实值。
# 真实密钥只允许存放在 .env（不入库），本文件仅保留占位符。

# 业务数据库路径
BEAUTY_DB_PATH=data/beauty_cs_agent.sqlite3

# Agent 提供方：mock（离线演示）或 qwen（真实调用）；启动脚本注入的真实环境变量优先
AGENT_PROVIDER=mock
QWEN_MOCK=1

# Qwen 兼容 API
QWEN_API_KEY=sk-your-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
# 图片识别（多模态）：带图请求自动切换到视觉模型
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_TIMEOUT=30
QWEN_TEMPERATURE=0.2

# 免费额度保护
QWEN_FREE_ONLY=true
QWEN_MAX_TOKENS=1024
QWEN_MAX_TOOL_ROUNDS=4
QWEN_EVAL_TOKEN_BUDGET=70000

# 模型行为与调试
QWEN_ENABLE_THINKING=false
QWEN_DEBUG_DIR=data/generated/live_debug

# 前端开发服务器指向的后端地址（Vite 构建期读取）
VITE_API_URL=http://localhost:9000
